# Salin file ini menjadi .env.local lalu isi dari Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Alamat website (dipakai untuk sitemap, gambar Open Graph, dan data terstruktur)
NEXT_PUBLIC_SITE_URL=https://portofolio-67.vercel.app

# --- Notifikasi email pesan baru (opsional) ---
# Daftar gratis di https://resend.com, buat API Key, lalu isi tiga baris ini (juga di Vercel → Environment Variables).
# Tanpa domain sendiri, Resend hanya mengizinkan kirim ke email akun Resend-mu, cukup untuk notifikasi ke diri sendiri.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=emailmu@gmail.com
# Opsional. Isi hanya bila domainmu sudah diverifikasi di Resend, mis. "Portofolio <halo@domainmu.com>"
NOTIFY_EMAIL_FROM=
